    <entry name="ioScaleMBps" type="Int"><default>400</default></entry>
    <entry name="animationsEnabled" type="Bool"><default>true</default></entry>
    <entry name="colorMode" type="Int"><default>0</default></entry>
    <entry name="filledColor" type="Color"><default>#67C4DE</default></entry>
    <entry name="writeColor" type="Color"><default>#E6B96A</default></entry>
    <entry name="emptyColor" type="Color"><default>#335363</default></entry>
    <entry name="trackColor" type="Color"><default>#547C8C</default></entry>
    <entry name="textColor" type="Color"><default>#E7EEF2</default></entry>
    <entry name="surfaceColor" type="Color"><default>#101D2B</default></entry>
    <entry name="warningColor" type="Color"><default>#E4818A</default></entry>
  </group>
</kcfg>
